# ClickMall backend environment template.
#
# Copy this file to backend-drf/.env and fill in real values.
#   cp .env.example .env
# backend-drf/.env is git-ignored. NEVER commit real credentials.
# Only the variables below are currently read by clickmart_main/settings.py.

# --- Django core -----------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-string

# Only the exact text "true" (any case) enables debug mode. Use False in production.
DEBUG=True

# Comma-separated host names, no spaces. Example: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# Leave EMPTY to use local SQLite (db.sqlite3).
# When set, SSL is currently required by settings.py, e.g.:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Email (order confirmation emails; SMTP host is Gmail in settings.py) ---
# For Gmail use an app password, not your account password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- AWS S3 (product image storage) ----------------------------------------
# settings.py currently uses S3 as the default file storage, so uploading
# product images requires these values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
