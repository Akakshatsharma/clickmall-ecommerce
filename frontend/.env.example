# ClickMall frontend environment template (Vite).
#
# Copy this file to frontend/.env (git-ignored):
#   cp .env.example .env
# Variables prefixed with VITE_ are embedded in the browser bundle and are
# PUBLIC. Never put secrets or API keys in this file.

# Base URL of the Django API, including the version prefix and no trailing slash.
VITE_SERVER_BASE_URL=http://127.0.0.1:8000/api/v1
